generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  // Supabase Postgres today; if this ever needs to move to a MySQL-only host
  // (e.g. Hostinger), see docs/DATABASE_MIGRATION.md for the provider swap +
  // data migration steps.
  provider = "postgresql"
  // Connection URLs live in prisma.config.ts (Migrate) and src/config/prisma.ts
  // (runtime client via driver adapter) — Prisma 7 no longer reads them here.
}

// Minimal model to prove the Prisma <-> Supabase Postgres round trip end to
// end (migrate, generate, query). Real domain models (User, Tour, Booking,
// ...) come later when the API itself is built.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  note      String   @default("ok")
  createdAt DateTime @default(now())
}

model Client {
  id        Int      @id @default(autoincrement())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  age       Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("clients")
}

// SUPER_ADMIN/ADMIN/TOUR_GUIDE ship with the eventual RBAC work in mind (see
// jdm_experience_backend's sandbox implementation); every identity created
// through Auth0 today defaults to CUSTOMER.
enum Role {
  SUPER_ADMIN
  ADMIN
  TOUR_GUIDE
  CUSTOMER
}

// Auth0 is the sole identity provider — there is no local password. A row is
// created on a user's first successful Auth0 login (see findOrCreateFromAuth0
// in src/services/user.service.ts); auth0Sub is Auth0's stable subject
// identifier (e.g. "auth0|..." or "google-oauth2|..."). Nullable: a row can
// also be pre-provisioned (e.g. migrated from another system) before anyone
// has actually logged in — it gets linked by matching email on first login.
model User {
  userId        Int            @id @default(autoincrement()) @map("user_id")
  auth0Sub      String?        @unique @map("auth0_sub")
  email         String         @unique
  fullName      String?        @map("full_name")
  /// Historical reference only (carried over from a legacy migration) — never used by auth
  /// logic, which matches by email/auth0Sub only.
  username      String?        @unique
  role          Role           @default(CUSTOMER)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  customer      Customer?
  tourGuide     TourGuide?
  bookings      Booking[]
  paymentProofs PaymentProof[]
  auditLogs     AuditLog[]
  reviews       Review[]
  cancellationRequests CancellationRequest[]
  wishlists     Wishlist[]

  @@map("users")
}

// Tour-level operational state (NOT per-date — per-date bookability is just "does a CONFIRMED
// Booking already exist for this tourId+bookingDate", see booking.service.ts; there's no separate
// availability/slot table). A new tour always starts PENDING; only an explicit admin confirmation
// (POST /tours/:id/confirm) moves it to AVAILABLE. From there, staff can move it manually between
// AVAILABLE/UNAVAILABLE/UNDER_MAINTENANCE. See tour.service.ts.
enum TourStatus {
  PENDING
  AVAILABLE
  UNAVAILABLE
  UNDER_MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REFUND_PROCESSING
  REFUNDED
  REJECTED
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  TWITTER
  YOUTUBE
}

enum PolicyType {
  PRIVACY
  TERMS
  BOOKING
  CANCELLATION
  PAYMENT
  CONDUCT
}

/// Guide-specific profile extension for TOUR_GUIDE users. Identity/login lives on `User`.
model TourGuide {
  id     Int     @id @default(autoincrement())
  userId Int     @unique @map("user_id")
  phone  String?
  bio    String?
  active Boolean @default(true)
  user   User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  tours  Tour[]

  @@map("tour_guides")
}

model Tour {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  description String?
  price       Decimal     @db.Decimal(10, 2)
  currency    String      @default("JPY") @db.VarChar(3)
  status      TourStatus  @default(PENDING)
  seats       Int         @default(1)
  guideId     Int?        @map("guide_id")
  /// Soft-delete marker, independent of `status` — status is purely the 4 operational values
  /// above; deletion is a separate axis so a deleted tour's last known status is never lost.
  /// Preserves related Bookings/Payments (never hard-deleted — see deleteTour in tour.service.ts).
  isDeleted   Boolean     @default(false) @map("is_deleted")
  deletedAt   DateTime?   @map("deleted_at")
  /// Customer-facing contact info shown once a booking on this tour is CONFIRMED (see the
  /// confirmation email in booking.service.ts) — deliberately separate from the owning
  /// TourGuide's own account email/phone, since staff may want the two to differ. Editable by
  /// the tour's own owner or SUPER_ADMIN only (see GET/PUT /tours/:id/contact).
  contactName  String?     @map("contact_name")
  contactEmail String?     @map("contact_email")
  contactPhone String?     @map("contact_phone")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  guide       TourGuide?  @relation(fields: [guideId], references: [id], onDelete: Restrict)
  images      TourImage[]
  bookings    Booking[]
  reviews     Review[]
  wishlists   Wishlist[]

  @@index([guideId])
  @@index([status])
  @@index([isDeleted])
  @@index([price])
  @@map("tours")
}

/// A review can only be created for a tour the reviewing user has actually completed -- see
/// review.service.ts's eligibility check (a COMPLETED Booking for this userId+tourId must exist).
/// One review per user per tour, enforced by the unique constraint below; editing/deleting is
/// restricted to the review's own author or staff (SUPER_ADMIN/ADMIN) -- see rbac.ts's requireRole.
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tourId    Int      @map("tour_id")
  rating    Int
  comment   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([userId, tourId])
  @@index([tourId])
  @@map("reviews")
}

/// A customer saving a tour for later viewing -- separate from Bookings entirely (see
/// wishlist.service.ts): booking/paying/confirming a tour never touches this table. One entry per
/// user per tour, enforced by the unique constraint below. Tours are soft-deleted (never actually
/// removed, see Tour.isDeleted), so this FK never breaks; listMyWishlist filters out deleted
/// tours at read time instead of relying on cascade cleanup.
model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tourId    Int      @map("tour_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([userId, tourId])
  @@index([userId])
  @@index([tourId])
  @@map("wishlists")
}

/// Metadata only — the actual file lives in object storage, never the database.
model TourImage {
  id        Int    @id @default(autoincrement())
  tourId    Int    @map("tour_id")
  imageUrl  String @map("image_url")
  sortOrder Int    @default(0) @map("sort_order")
  tour      Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@map("tour_images")
}

/// Travel-profile extension for CUSTOMER users. Identity/login lives on `User`.
model Customer {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique @map("user_id")
  phone          String?
  nationality    String?
  passportNumber String?  @map("passport_number")
  licenseNumber  String?  @map("license_number")
  licenseCountry String?  @map("license_country")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("customers")
}

// A tour-date is exclusive to at most one CONFIRMED booking at a time (like reserving the whole
// vehicle for that day, not a seat within it) — enforced in booking.service.ts (createBooking and
// updateBookingStatus both check for a conflicting CONFIRMED booking on the same tourId+bookingDate
// before allowing one). `participants` is only a display/capacity-cap concept against Tour.seats,
// never a shared pool split across multiple bookings on the same date.
model Booking {
  id                Int            @id @default(autoincrement())
  userId            Int            @map("user_id")
  tourId            Int            @map("tour_id")
  bookingDate       DateTime       @map("booking_date") @db.Date
  participants      Int            @default(1)
  status            BookingStatus  @default(PENDING)
  totalPrice        Decimal        @map("total_price") @db.Decimal(10, 2)
  depositPaid       Decimal        @default(0.00) @map("deposit_paid") @db.Decimal(10, 2)
  paymentStatus     PaymentStatus  @default(UNPAID) @map("payment_status")
  tourNameSnapshot  String         @map("tour_name_snapshot")
  unitPriceSnapshot Decimal        @map("unit_price_snapshot") @db.Decimal(10, 2)
  currency          String         @default("JPY") @db.VarChar(3)
  specialRequests   String?        @map("special_requests")
  /// Contact details captured at booking time (not always the same as the User's own account
  /// info) -- used for the confirmation email and by staff reviewing the booking.
  customerName      String?        @map("customer_name")
  customerEmail     String?        @map("customer_email")
  customerPhone     String?        @map("customer_phone")
  paymentMethodId   Int?           @map("payment_method_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  user              User           @relation(fields: [userId], references: [userId], onUpdate: Restrict)
  tour              Tour           @relation(fields: [tourId], references: [id], onUpdate: Restrict)
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  payments          Payment[]
  paymentProofs     PaymentProof[]
  cancellationRequest CancellationRequest?

  @@index([userId])
  @@index([tourId])
  @@index([status])
  @@index([tourId, bookingDate])
  @@index([paymentMethodId])
  @@map("bookings")
}

/// Managed by SUPER_ADMIN (see payment-method.routes.ts) -- customers only ever see the active
/// ones (GET /payment-methods). Deactivating rather than deleting preserves historical bookings'
/// paymentMethod reference; deleting one still leaves those bookings intact (paymentMethodId ->
/// null, see Booking.paymentMethod's onDelete above) rather than failing.
model PaymentMethod {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?   @map("image_url")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  bookings    Booking[]
  cancellationRequests CancellationRequest[]

  @@index([isActive])
  @@map("payment_methods")
}

model Payment {
  id             Int           @id @default(autoincrement())
  bookingId      Int           @map("booking_id")
  provider       String?
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("JPY") @db.VarChar(3)
  status         PaymentStatus @default(UNPAID)
  paymentMethod  String?       @map("payment_method")
  paymentDate    DateTime      @default(now()) @map("payment_date")
  paidAt         DateTime?     @map("paid_at")
  transactionRef String?       @map("transaction_ref")
  booking        Booking       @relation(fields: [bookingId], references: [id], onUpdate: Restrict)

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

/// Metadata only — the actual file lives in object storage, never the database.
model PaymentProof {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @map("booking_id")
  uploadedBy Int      @map("uploaded_by")
  fileUrl    String   @map("file_url")
  fileName   String   @map("file_name")
  fileType   String   @map("file_type")
  createdAt  DateTime @default(now()) @map("created_at")
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploadedBy], references: [userId])

  @@index([bookingId])
  @@map("payment_proofs")
}

/// A paid/confirmed booking's cancellation + refund workflow -- distinct from the direct
/// self-cancel path for PENDING+UNPAID bookings (see cancelOwnBooking in booking.service.ts),
/// which needs no request/approval step. One request per booking, ever (bookingId is unique) --
/// once submitted, approved/rejected/refunded, no second request can be created for that booking.
/// refundMethodId reuses the existing dynamic PaymentMethod list (same pattern as
/// Booking.paymentMethodId); refundMethodNameSnapshot preserves the name even if that method is
/// later deactivated/deleted, same as Booking.tourNameSnapshot. Approval/refund-processing never
/// touch the Booking itself -- only completeRefund (status -> REFUNDED here) also transitions the
/// Booking to CANCELLED/REFUNDED, via the existing updateBookingStatus in booking.service.ts.
model CancellationRequest {
  id                       Int                        @id @default(autoincrement())
  bookingId                Int                        @unique @map("booking_id")
  customerId               Int                        @map("customer_id")
  reason                   String
  refundMethodId           Int?                       @map("refund_method_id")
  refundMethodNameSnapshot String                     @map("refund_method_name_snapshot")
  refundDestination        String                     @map("refund_destination")
  refundAmount             Decimal                    @map("refund_amount") @db.Decimal(10, 2)
  status                   CancellationRequestStatus  @default(PENDING)
  rejectionReason          String?                    @map("rejection_reason")
  refundProofUrl           String?                    @map("refund_proof_url")
  refundProofFileName      String?                    @map("refund_proof_file_name")
  refundProofFileType      String?                    @map("refund_proof_file_type")
  approvedAt               DateTime?                  @map("approved_at")
  rejectedAt               DateTime?                  @map("rejected_at")
  refundedAt               DateTime?                  @map("refunded_at")
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")
  booking                  Booking                    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer                 User                       @relation(fields: [customerId], references: [userId])
  refundMethod             PaymentMethod?             @relation(fields: [refundMethodId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([customerId])
  @@map("cancellation_requests")
}

model ContactMessage {
  id        Int                  @id @default(autoincrement())
  name      String?
  email     String?
  subject   String?
  message   String?
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@index([status])
  @@map("contact_messages")
}

model AppSettings {
  id                Int      @id
  locationName      String   @default("Tokyo, Japan") @map("location_name")
  latitude          Decimal  @db.Decimal(9, 6)
  longitude         Decimal  @db.Decimal(9, 6)
  address           String?
  timezone          String?  @default("Asia/Tokyo")
  contactEmail      String?  @map("contact_email")
  contactPhone      String?  @map("contact_phone")
  contactHours      String?  @map("contact_hours")
  bookingCutoffHour Int      @default(17) @map("booking_cutoff_hour")
  updatedAt         DateTime @default(now()) @map("updated_at")

  @@map("app_settings")
}

model SocialMediaLink {
  id           Int            @id @default(autoincrement())
  platform     SocialPlatform @unique
  url          String
  enabled      Boolean        @default(true)
  displayOrder Int            @default(0) @map("display_order")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([enabled])
  @@map("social_media_links")
}

/** Single global row (id=1), same pattern as AppSettings -- the public About Us page's title +
 *  body, editable from Website Settings instead of hardcoded in React. */
model AboutContent {
  id        Int      @id
  title     String
  content   String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("about_content")
}

/** One row per policy type (Privacy, Terms, Booking, Cancellation, Payment, Conduct) -- a type
 *  with no row (or empty content) is simply not shown on the public Policy page, mirroring how an
 *  unset social media link hides its icon rather than showing a blank/broken section. */
model PolicyPage {
  id        Int        @id @default(autoincrement())
  type      PolicyType @unique
  title     String
  content   String
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("policy_pages")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  entity    String
  entityId  Int?     @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [userId], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}
