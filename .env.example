# Server
PORT=3000
NODE_ENV=development

# CORS — the frontend dev server origin (Vite default)
CORS_ORIGIN=http://localhost:5173

# Auth0 — every protected request's bearer token is verified against this tenant (issuer) +
# API (audience). Must match the frontend's VITE_AUTH0_DOMAIN/VITE_AUTH0_AUDIENCE exactly.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Database — Supabase Postgres.
# DATABASE_URL: pooled connection (pgbouncer, transaction mode, port 6543) — used by the app at runtime.
# DIRECT_URL: direct connection (port 5432) — required for migrations.
# Get both from Supabase project settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[host].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[host].pooler.supabase.com:5432/postgres"

# Supabase Storage — used by POST /uploads/tour-images to issue signed upload URLs so the browser
# uploads image files directly to Storage (they never pass through this API).
# SUPABASE_URL: project URL, e.g. https://<project-ref>.supabase.co (Settings -> API).
# SUPABASE_SERVICE_ROLE_KEY: service_role key (Settings -> API) — server-only, never exposed to the client.
# SUPABASE_STORAGE_BUCKET: public-read bucket for tour images. Create it once with:
#   insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
#   values ('tour-images','tour-images', true, 5242880,
#           array['image/jpeg','image/png','image/webp','image/avif'])
#   on conflict (id) do nothing;
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tour-images
