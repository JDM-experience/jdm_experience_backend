# Server
PORT=3000
NODE_ENV=development

# CORS — the frontend dev server origin (Vite default)
CORS_ORIGIN=http://localhost:5173

# Auth — signs/verifies the httpOnly session JWT cookie. Set a long random value in production.
JWT_SECRET=

# Google Sign-In verification (see docs/API.md). Leave blank to disable /api/auth/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google reCAPTCHA v2 secret key. Leave blank to skip CAPTCHA verification on login.
RECAPTCHA_SECRET_KEY=

# Database
DATABASE_URL=
